// =================== 1. FIREBASE & UTILS ===================
const firebaseConfig = { databaseURL: "https://ecogrowth-v2-default-rtdb.asia-southeast1.firebasedatabase.app/" };
if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const db = firebase.database();
const currentRef = db.ref("current");
const configRef = db.ref("config");
const historyRef = db.ref("history");
const connectedRef = db.ref(".info/connected");

function escapeHtml(str) {
  if (!str) return "";
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

let AppState = {
  config: {},
  historyList: [],
  alertHistory: [],
  realtimeBuffer: { labels: [], moisture: [], setpoint: [], temp: [] },
  maxBufferPoints: 20
};

// =================== 2. CHART.JS INITIALIZATION ===================
let realtimeTrendChartInstance = null;
let waterUsageChartInstance = null;

function initCharts() {
  const ctxTrend = document.getElementById("realtimeTrendChart");
  if (ctxTrend) {
    realtimeTrendChartInstance = new Chart(ctxTrend.getContext("2d"), {
      type: "line",
      data: {
        labels: [],
        datasets: [
          { label: "Độ ẩm đất (%)", borderColor: "#10B981", backgroundColor: "rgba(16, 185, 129, 0.08)", data: [], tension: 0.35, fill: true, pointRadius: 2, yAxisID: "y" },
          { label: "Setpoint (%)", borderColor: "rgba(16, 185, 129, 0.4)", borderDash: [5, 5], data: [], pointRadius: 0, fill: false, yAxisID: "y" },
          { label: "Nhiệt độ (°C)", borderColor: "#FB923C", data: [], tension: 0.35, fill: false, pointRadius: 2, yAxisID: "y1" }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false, interaction: { mode: "index", intersect: false },
        scales: {
          x: { grid: { display: false } },
          y: { type: "linear", display: true, position: "left", min: 0, max: 100, ticks: { callback: (val) => val + "%" } },
          y1: { type: "linear", display: true, position: "right", min: 10, max: 50, grid: { drawOnChartArea: false }, ticks: { callback: (val) => val + "°C" } }
        },
        plugins: { legend: { display: false } }
      }
    });
  }

  const ctxUsage = document.getElementById("waterUsageChart");
  if (ctxUsage) {
    waterUsageChartInstance = new Chart(ctxUsage.getContext("2d"), {
      type: "bar",
      data: { labels: [], datasets: [{ label: "Thể tích (ml)", backgroundColor: "#38BDF8", borderRadius: 6, data: [] }] },
      options: { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { display: false } }, y: { beginAtZero: true, ticks: { callback: (val) => val + " ml" } } }, plugins: { legend: { display: false } } }
    });
  }
}

// =================== 3. FIREBASE LISTENERS ===================
connectedRef.on("value", (snap) => {
  const isConnected = snap.val() === true;
  const statusEl = document.getElementById("connectionStatus");
  if (statusEl) {
    if (isConnected) {
      statusEl.className = "flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Online</span>`;
    } else {
      statusEl.className = "flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span><span>Offline</span>`;
    }
  }
});

currentRef.on("value", (snapshot) => {
  const val = snapshot.val();
  if (!val) return;
  updateTelemetryUI(val);
  updateSmartAdvisor(val);
  pushRealtimeChartData(val);
});

configRef.on("value", (snapshot) => {
  const cfg = snapshot.val();
  if (!cfg) return;
  AppState.config = Object.assign(AppState.config, cfg);

  if (document.getElementById("inputKp")) document.getElementById("inputKp").value = cfg.kp || 2.0;
  if (document.getElementById("inputKi")) document.getElementById("inputKi").value = cfg.ki || 0.5;
  if (document.getElementById("inputKd")) document.getElementById("inputKd").value = cfg.kd || 0.1;
  if (document.getElementById("inputRainThreshold")) document.getElementById("inputRainThreshold").value = cfg.rain_threshold_hpa || 1.5;
  if (document.getElementById("inputTelegramChatId")) document.getElementById("inputTelegramChatId").value = cfg.telegram_chat_id || "";
  
  if (cfg.soil_setpoint !== undefined) {
    if (document.getElementById("setpointSlider")) document.getElementById("setpointSlider").value = cfg.soil_setpoint;
    if (document.getElementById("setpointValueDisplay")) document.getElementById("setpointValueDisplay").textContent = cfg.soil_setpoint;
    if (document.getElementById("teleSetpointDisplay")) document.getElementById("teleSetpointDisplay").textContent = `${cfg.soil_setpoint}%`;
  }
  
  const isAuto = String(cfg.mode).toUpperCase() === "AUTO";
  const btnAuto = document.getElementById("btnModeAuto");
  const btnManual = document.getElementById("btnModeManual");
  const pumpModeTag = document.getElementById("telePumpModeTag");

  if (isAuto) {
    if (btnAuto) btnAuto.className = "px-3 py-1 rounded-lg text-xs font-bold transition-all bg-white text-emerald-600 shadow-sm";
    if (btnManual) btnManual.className = "px-3 py-1 rounded-lg text-xs font-bold transition-all text-gray-500 hover:text-gray-800";
    if (pumpModeTag) pumpModeTag.textContent = "Chế độ AUTO";
    
    // Khi nhận tín hiệu AUTO: giải phóng nút bấm
    const btnTrigger = document.getElementById("btnManualTrigger");
    const btnText = document.getElementById("btnManualTriggerText");
    const timerWrapper = document.getElementById("manualTimerWrapper");
    if (btnTrigger) btnTrigger.disabled = false;
    if (btnText) btnText.textContent = "TƯỚI NGAY (150ml)";
    if (timerWrapper) timerWrapper.classList.add("hidden");
  } else {
    if (btnManual) btnManual.className = "px-3 py-1 rounded-lg text-xs font-bold transition-all bg-white text-emerald-600 shadow-sm";
    if (btnAuto) btnAuto.className = "px-3 py-1 rounded-lg text-xs font-bold transition-all text-gray-500 hover:text-gray-800";
    if (pumpModeTag) pumpModeTag.textContent = "Chế độ MANUAL";
  }
});

historyRef.limitToLast(100).on("value", (snapshot) => {
  const data = snapshot.val();
  if (data) {
    AppState.historyList = Object.entries(data).map(([key, value]) => ({ id: key, ...value }));
    AppState.historyList.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
  } else {
    AppState.historyList = [];
  }
  updateGardenLogUI(AppState.historyList);
  updateWaterUsageChart(AppState.historyList);
  calculateWeeklyReport(AppState.historyList);
});

// =================== 4. UI UPDATE ===================
function updateTelemetryUI(data) {
  const soil = Number(data.soil_moisture || 0);
  if (document.getElementById("teleSoil")) document.getElementById("teleSoil").textContent = soil.toFixed(1);
  if (document.getElementById("soilGaugePath")) document.getElementById("soilGaugePath").setAttribute("stroke-dasharray", `${soil}, 100`);
  
  const temp = Number(data.temperature || 0);
  const hum = Number(data.humidity || 0);
  if (document.getElementById("teleTemp")) document.getElementById("teleTemp").textContent = temp.toFixed(1);
  if (document.getElementById("teleHumidity")) document.getElementById("teleHumidity").textContent = hum.toFixed(1);
  if (document.getElementById("tempBar")) document.getElementById("tempBar").style.width = `${Math.min(100, Math.max(0, (temp / 50) * 100))}%`;
  if (document.getElementById("humBar")) document.getElementById("humBar").style.width = `${Math.min(100, Math.max(0, hum))}%`;
  
  const lux = Number(data.lux || 0);
  if (document.getElementById("teleLux")) document.getElementById("teleLux").textContent = lux;
  if (document.getElementById("luxBar")) document.getElementById("luxBar").style.width = `${Math.min(100, (lux / 3000) * 100)}%`;
  
  const press = Number(data.pressure || 1013.25);
  if (document.getElementById("telePressure")) document.getElementById("telePressure").textContent = press.toFixed(1);
  
  const isPumpOn = String(data.pump_status).toUpperCase() === "ON";
  const pumpText = document.getElementById("telePumpStatus");
  const pumpLed = document.getElementById("pumpLed");
  const pumpLedPing = document.getElementById("pumpLedPing");

  if (isPumpOn) {
    if (pumpText) { pumpText.textContent = "ON (Đang bơm)"; pumpText.className = "text-lg font-bold text-emerald-600"; }
    if (pumpLed) pumpLed.className = "w-4 h-4 rounded-full led-active relative z-10";
    if (pumpLedPing) pumpLedPing.className = "absolute w-7 h-7 rounded-full led-ping-active";
  } else {
    if (pumpText) { pumpText.textContent = "OFF"; pumpText.className = "text-lg font-bold text-gray-700"; }
    if (pumpLed) pumpLed.className = "w-4 h-4 rounded-full bg-gray-300 relative z-10";
    if (pumpLedPing) pumpLedPing.className = "absolute w-7 h-7 rounded-full bg-gray-200";
  }

  const rainBadge = document.getElementById("rainBadge");
  if (rainBadge) {
    if (data.rain_flag === true) { rainBadge.classList.remove("hidden"); rainBadge.classList.add("flex"); }
    else { rainBadge.classList.add("hidden"); rainBadge.classList.remove("flex"); }
  }

  if (data.last_updated && document.getElementById("teleLastUpdated")) {
    const d = new Date(data.last_updated < 1e11 ? data.last_updated * 1000 : data.last_updated);
    document.getElementById("teleLastUpdated").textContent = d.toLocaleTimeString("vi-VN");
  }
}

// =================== 5. ĐIỀU KHIỂN & ĐẾM NGƯỢC THÔNG MINH ===================
function triggerManualWatering() {
  const btn = document.getElementById("btnManualTrigger");
  const btnText = document.getElementById("btnManualTriggerText");
  if (btn) btn.disabled = true;
  if (btnText) btnText.textContent = "ĐANG KÍCH HOẠT...";

  configRef.update({
    manual_trigger: true,
    manual_trigger_started_at: Date.now(),
    mode: "MANUAL"
  });
}

function syncPassiveManualCountdown() {
  const timerWrapper = document.getElementById("manualTimerWrapper");
  const timeDisplay = document.getElementById("manualTimeRemaining");
  const progressBar = document.getElementById("manualTimerProgress");
  const btn = document.getElementById("btnManualTrigger");
  const btnText = document.getElementById("btnManualTriggerText");

  if (!timerWrapper) return;

  if (AppState.config.mode === "MANUAL" && AppState.config.manual_trigger_started_at) {
    const startedAt = AppState.config.manual_trigger_started_at < 1e11 
        ? AppState.config.manual_trigger_started_at * 1000 
        : AppState.config.manual_trigger_started_at;
    
    const elapsed = Math.floor((Date.now() - startedAt) / 1000);
    const duration = 60; // 60s thời lượng tưới
    const remaining = Math.max(0, duration - elapsed);

    if (remaining > 0) {
      timerWrapper.classList.remove("hidden");
      if (timeDisplay) timeDisplay.textContent = `${remaining}s`;
      if (progressBar) progressBar.style.width = `${(remaining / duration) * 100}%`;
      if (btn) btn.disabled = true;
      if (btnText) btnText.textContent = `ĐANG TƯỚI THỦ CÔNG (${remaining}s)...`;
      return;
    } else {
      // Hết 60s: Nếu ESP32 chưa kịp gửi lệnh, client tự chủ động gửi trả về AUTO
      configRef.update({ mode: "AUTO", manual_trigger: false });
      if (btn) btn.disabled = false;
      if (btnText) btnText.textContent = "TƯỚI NGAY (150ml)";
      timerWrapper.classList.add("hidden");
    }
  } else {
    timerWrapper.classList.add("hidden");
    if (btn && AppState.config.mode === "AUTO") {
      btn.disabled = false;
      if (btnText) btnText.textContent = "TƯỚI NGAY (150ml)";
    }
  }
}

// =================== 6. BÁO CÁO 7 NGÀY & LOG ===================
function calculateWeeklyReport(historyList) {
  if (!historyList || historyList.length === 0) return;

  const sevenDaysAgo = Date.now() - (7 * 24 * 60 * 60 * 1000);
  const weeklyLogs = historyList.filter(item => {
    const itemTime = item.timestamp < 1e11 ? item.timestamp * 1000 : item.timestamp;
    return itemTime >= sevenDaysAgo;
  });

  let totalWater = 0, moistureSum = 0, rainHoldCount = 0;
  weeklyLogs.forEach(item => {
    totalWater += Number(item.ml_used || 0);
    moistureSum += Number(item.moisture_after || 50);
    if (String(item.trigger).toUpperCase() === "RAIN_HOLD") rainHoldCount++;
  });

  const avgMoisture = weeklyLogs.length > 0 ? (moistureSum / weeklyLogs.length).toFixed(1) : "--";
  if (document.getElementById("reportTotalWater")) document.getElementById("reportTotalWater").textContent = totalWater;
  if (document.getElementById("reportTotalCycles")) document.getElementById("reportTotalCycles").textContent = weeklyLogs.length;
  if (document.getElementById("reportAvgMoisture")) document.getElementById("reportAvgMoisture").textContent = avgMoisture;
  if (document.getElementById("reportRainHolds")) document.getElementById("reportRainHolds").textContent = rainHoldCount;
}

function updateGardenLogUI(historyList) {
  const tbody = document.getElementById("gardenLogTableBody");
  if (!tbody || !historyList.length) return;

  tbody.innerHTML = historyList.map(log => {
    const timeStr = escapeHtml(new Date(log.timestamp < 1e11 ? log.timestamp * 1000 : log.timestamp).toLocaleString("vi-VN"));
    const trigger = escapeHtml(String(log.trigger || "AUTO").toUpperCase());
    const mlUsed = escapeHtml(Number(log.ml_used || 0));
    const mBefore = log.moisture_before !== undefined ? `${Number(log.moisture_before).toFixed(1)}%` : "--";
    const mAfter = log.moisture_after !== undefined ? `${Number(log.moisture_after).toFixed(1)}%` : "--";
    const kpUpdated = log.kp_updated !== undefined ? Number(log.kp_updated).toFixed(2) : "--";
    
    return `<tr>
      <td class="py-3 px-4 font-mono">${timeStr}</td>
      <td class="py-3 px-4">${trigger}</td>
      <td class="py-3 px-4 text-right font-bold">${mlUsed} ml</td>
      <td class="py-3 px-4 text-center">${mBefore} → <span class="text-emerald-600 font-semibold">${mAfter}</span></td>
      <td class="py-3 px-4 text-right">${kpUpdated}</td>
    </tr>`;
  }).join("");
}

function updateAdvancedParameters(e) {
  e.preventDefault();
  configRef.update({
    kp: parseFloat(document.getElementById("inputKp").value),
    ki: parseFloat(document.getElementById("inputKi").value),
    kd: parseFloat(document.getElementById("inputKd").value),
    rain_threshold_hpa: parseFloat(document.getElementById("inputRainThreshold").value),
    telegram_chat_id: document.getElementById("inputTelegramChatId").value.trim()
  }).then(() => alert("Cấu hình đã được lưu an toàn!"));
}

function setControlMode(mode) { configRef.update({ mode: mode, manual_trigger: false }); }
function applyPreset(setpoint) { onSetpointSliderChange(setpoint); commitSetpoint(setpoint); }
function onSetpointSliderChange(val) { if (document.getElementById("setpointValueDisplay")) document.getElementById("setpointValueDisplay").textContent = val; }
function commitSetpoint(val) { configRef.update({ soil_setpoint: Number(val) }); }

function updateSmartAdvisor(data) {
  const banner = document.getElementById("smartAdvisorBanner");
  if (!banner) return;
  const msgEl = document.getElementById("advisorMessage");
  const iconEl = document.getElementById("advisorIcon");

  let alertLevel = null; let message = ""; let alertType = "info";
  const soil = Number(data.soil_moisture || 50); const temp = Number(data.temperature || 25);
  const hum = Number(data.humidity || 60); const lux = Number(data.lux || 1000);

  if (soil < 20) { alertLevel = "danger"; alertType = "danger"; message = `Khô hạn nghiêm trọng (${soil}%)!`; }
  else if (soil > 85) { alertLevel = "warning"; alertType = "warning"; message = `Độ ẩm đất cao (${soil}%). Nguy cơ ngập úng.`; }
  else if (temp > 36 && hum < 35) { alertLevel = "danger"; alertType = "danger"; message = `Sốc nhiệt! Nhiệt độ: ${temp}°C, Ẩm: ${hum}%.`; }
  else if (lux < 400) { alertLevel = "info"; alertType = "info"; message = `Thiếu sáng (${lux} Lux). Cần vị trí đón sáng.`; }

  if (alertLevel) {
    banner.classList.remove("hidden"); msgEl.textContent = message;
    if (alertLevel === "danger") { banner.className = "px-4 py-2.5 text-xs sm:text-sm font-medium transition-all bg-rose-500 text-white shadow-sm flex items-center"; iconEl.className = "fa-solid fa-triangle-exclamation text-base"; }
    else if (alertLevel === "warning") { banner.className = "px-4 py-2.5 text-xs sm:text-sm font-medium transition-all bg-amber-500 text-white shadow-sm flex items-center"; iconEl.className = "fa-solid fa-circle-exclamation text-base"; }
    else { banner.className = "px-4 py-2.5 text-xs sm:text-sm font-medium transition-all bg-blue-600 text-white shadow-sm flex items-center"; iconEl.className = "fa-solid fa-circle-info text-base"; }
    
    const isDup = AppState.alertHistory.length > 0 && AppState.alertHistory[0].message === message;
    if (!isDup) { 
      AppState.alertHistory.unshift({ timestamp: Date.now(), type: alertType, message, icon: alertType === "danger" ? "fa-triangle-exclamation" : (alertType === "warning" ? "fa-circle-exclamation" : "fa-circle-info") }); 
      if (AppState.alertHistory.length > 10) AppState.alertHistory.pop(); 
      renderAlertHistoryUI(); 
    }
  } else { banner.classList.add("hidden"); }
}

function renderAlertHistoryUI() {
  const container = document.getElementById("alertHistoryList");
  if (!container) return;
  const badge = document.getElementById("alertCounterBadge");
  if (badge) badge.textContent = `${AppState.alertHistory.length} sự kiện`;
  container.innerHTML = AppState.alertHistory.map(item => {
    const timeStr = new Date(item.timestamp).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
    let badgeClass = item.type === "danger" ? "bg-rose-50 text-rose-700 border-rose-200" : (item.type === "warning" ? "bg-amber-50 text-amber-700 border-amber-200" : "bg-blue-50 text-blue-700 border-blue-200");
    return `<div class="p-3 rounded-xl border ${badgeClass} text-xs flex items-start space-x-2.5"><i class="fa-solid ${escapeHtml(item.icon)} mt-0.5 text-sm"></i><div class="flex-1"><p class="font-medium leading-snug">${escapeHtml(item.message)}</p><span class="text-[10px] opacity-75 font-mono mt-1 block">${escapeHtml(timeStr)}</span></div></div>`;
  }).join("");
}

function dismissAdvisor() {
  const banner = document.getElementById("smartAdvisorBanner");
  if (banner) banner.classList.add("hidden");
}

function pushRealtimeChartData(data) {
  if (!realtimeTrendChartInstance) return;
  const now = new Date();
  const timeLabel = now.toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
  const buf = AppState.realtimeBuffer;
  buf.labels.push(timeLabel); buf.moisture.push(Number(data.soil_moisture || 0)); buf.setpoint.push(Number(AppState.config.soil_setpoint || 60)); buf.temp.push(Number(data.temperature || 0));
  if (buf.labels.length > AppState.maxBufferPoints) { buf.labels.shift(); buf.moisture.shift(); buf.setpoint.shift(); buf.temp.shift(); }
  realtimeTrendChartInstance.data.labels = buf.labels; realtimeTrendChartInstance.data.datasets[0].data = buf.moisture; realtimeTrendChartInstance.data.datasets[1].data = buf.setpoint; realtimeTrendChartInstance.data.datasets[2].data = buf.temp;
  realtimeTrendChartInstance.update("none");
}

function updateWaterUsageChart(historyList) {
  if (!waterUsageChartInstance || !historyList) return;
  const labels = [], volumes = [];
  const items = historyList.slice(0, 7).reverse();
  items.forEach((item, idx) => {
    const timeStr = item.timestamp ? new Date(item.timestamp < 1e11 ? item.timestamp * 1000 : item.timestamp).toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" }) : `Lần ${idx + 1}`;
    labels.push(timeStr); volumes.push(Number(item.ml_used || 0));
  });
  waterUsageChartInstance.data.labels = labels; waterUsageChartInstance.data.datasets[0].data = volumes; waterUsageChartInstance.update();
}

setInterval(() => {
  const clock = document.getElementById("liveClock");
  if (clock) clock.textContent = new Date().toLocaleTimeString("vi-VN");
  syncPassiveManualCountdown();
}, 1000);

document.addEventListener("DOMContentLoaded", () => { initCharts(); renderAlertHistoryUI(); });
