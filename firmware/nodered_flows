  {
    "id": "func_virtual_sensors",
    "type": "function",
    "z": "tab_master",
    "name": "Tạo dữ liệu & Đánh giá Smart Advisor",
    "func": "// 1. Giả lập giá trị 4 nhóm cảm biến của EcoGrowth Hub V2\nlet soil = +(30 + Math.random() * 40).toFixed(1);\nlet temp = +(26 + Math.random() * 12).toFixed(1); // Nhiệt độ dao động\nlet hum = +(40 + Math.random() * 30).toFixed(1);\nlet lux = Math.floor(400 + Math.random() * 1500);\nlet press = +(1008 + Math.random() * 6).toFixed(1);\n\nlet telemetry = {\n    soil_moisture: soil,\n    temperature: temp,\n    humidity: hum,\n    lux: lux,\n    pressure: press,\n    pump_status: soil < 40 ? \"ON\" : \"OFF\",\n    rain_flag: false,\n    last_updated: Math.floor(Date.now() / 1000)\n};\n\n// 2. Logic Smart Advisor: Đẩy cảnh báo nếu có bất thường\nlet alertMsg = \"\";\nif (soil < 32.0) {\n    alertMsg = `⚠ [EcoGrowth Hub]: Cây đang khát nước nghiêm trọng! (Độ ẩm đất: ${soil}%)`;\n} else if (temp > 36.0 && hum < 45.0) {\n    alertMsg = `🔥 [EcoGrowth Hub]: Cảnh báo sốc nhiệt! (Nhiệt độ: ${temp}°C, Độ ẩm: ${hum}%)`;\n} else if (lux < 500) {\n    alertMsg = `☁ [EcoGrowth Hub]: Cảnh báo thiếu sáng liên tục! (Lux: ${lux})`;\n}\n\nreturn [\n    { payload: telemetry }, // Chân 1: Bắn lên MQTT & Firebase\n    alertMsg ? { payload: alertMsg } : null // Chân 2: Kích hoạt Telegram nếu có cảnh báo\n];",
    "outputs": 2,
    "x": 490,
    "y": 120,
    "wires": [
      [
        "mqtt_out_all",
        "http_firebase_write",
        "func_split_dashboard"
      ],
      [
        "func_tg_format"
      ]
    ]
  },
